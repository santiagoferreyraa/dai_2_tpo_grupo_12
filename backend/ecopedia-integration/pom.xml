<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ecopedia</groupId>
        <artifactId>ecopedia-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ecopedia-integration</artifactId>
    <name>Ecopedia — Integration</name>
    <description>
        Componentes: PaymentService (REST hacia la pasarela simulada),
        PowerGridService (SOAP hacia la distribuidora simulada).
        Concentra toda la salida hacia sistemas externos en un borde único.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Seguridad declarativa: habilita @PreAuthorize sobre las operaciones de Pagos.

            Este artefacto valida el token por su cuenta, con la misma clave que lo firmó core.
            No depende de ecopedia-core para eso: la autenticación stateless de RNF07 existe
            justamente para que cada artefacto resuelva el token en su propia capa de
            presentación, sin preguntarle a nadie. Ver ARQUITECTURA §2.2.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Lectura del token JWT. Acá solo se valida y se leen claims: emitirlo es de Usuarios. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            Con JPA desde ECO-26: este módulo SÍ tiene tabla propia.

            El comentario que estaba acá decía que si PaymentService terminaba guardando medios
            de pago había que agregar JPA, Flyway y el datasource. Eso es exactamente lo que
            pasó: RF02 obliga a persistir marca, últimos cuatro y token del conductor. El
            número completo sigue sin guardarse en ninguna parte.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- El esquema lo gobierna Flyway, no Hibernate. Ver README, "Migraciones". -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Motor de base de datos objetivo (perfil por defecto) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Solo para el perfil 'dev': levantar el módulo sin PostgreSQL instalado. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            El cliente SOAP de RedEléctrica hacia la distribuidora (ARQUITECTURA §3.1).

            spring-ws-core y no el starter de web services: este módulo solo CONSUME un servicio
            SOAP, no publica ninguno. El starter levantaría un MessageDispatcherServlet vacío en
            /services; igual, la autoconfiguración que lo hace queda excluida en el application.yml,
            porque spring-ws-core alcanza para activarla.
        -->
        <dependency>
            <groupId>org.springframework.ws</groupId>
            <artifactId>spring-ws-core</artifactId>
        </dependency>

        <!-- WS-Security: el UsernameToken que exige la distribuidora, con WSS4J. -->
        <dependency>
            <groupId>org.springframework.ws</groupId>
            <artifactId>spring-ws-security</artifactId>
        </dependency>

        <!-- Lee y escribe las clases que JAXB genera del contrato. -->
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MockWebServiceServer: el cliente SOAP contra una distribuidora de mentira. -->
        <dependency>
            <groupId>org.springframework.ws</groupId>
            <artifactId>spring-ws-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                Las clases del contrato de la distribuidora, generadas de la copia del contrato que
                vive en este módulo (src/main/resources/wsdl/). El WSDL importa ese XSD, y se genera
                del XSD porque es donde están los tipos. Las clases quedan en target/.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>jaxb2-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>xjc</id>
                        <goals>
                            <goal>xjc</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <sources>
                        <source>src/main/resources/wsdl/power-grid.xsd</source>
                    </sources>
                    <packageName>com.ecopedia.integration.powergrid.ws.contract</packageName>
                    <noGeneratedHeaderComments>true</noGeneratedHeaderComments>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
