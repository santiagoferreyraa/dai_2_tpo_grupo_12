<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ecopedia</groupId>
        <artifactId>ecopedia-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ecopedia-core</artifactId>
    <name>Ecopedia — Core</name>
    <description>
        Componentes: ServicioDeTerminales, ServicioDeUsuarios, ServicioDeTarificacion.
        Todos stateless.
    </description>

    <properties>
        <!-- El frontend vive fuera de este módulo. Lo usa el perfil 'web' de abajo. -->
        <frontend.dir>${project.basedir}/../../frontend</frontend.dir>
    </properties>

    <dependencies>
        <!-- Capa de presentación: controladores REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validación declarativa de los DTO de entrada -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Seguridad declarativa: habilita @PreAuthorize sobre las operaciones sensibles.
            Ver SecurityConfig: por ahora deja pasar todo, para no trabar las pruebas
            manuales mientras el componente de Usuarios no exista.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Token JWT para autenticación stateless -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Capa de datos: soporte para la implementación JPA de los DAO -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- El esquema lo gobierna Flyway, no Hibernate. Ver README, "Migraciones". -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Motor de base de datos objetivo (perfil por defecto) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Solo para el perfil 'dev': permite levantar la aplicación sin PostgreSQL instalado.
            La demo de las entregas corre sobre PostgreSQL, no sobre H2.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Solo para ChargerLiveTest, que escucha el tópico telemetry.charging mientras enciende un
            conector del simulador. Core no publica ni escucha mensajes: por eso es de test, y el
            cliente a secas, sin el starter, que sumaría spring-jms y el JmsTemplate.
        -->
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>artemis-jakarta-client</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
        Perfil 'web': mete el frontend adentro de este JAR.

            mvn -Pweb clean package
            java -jar backend/ecopedia-core/target/ecopedia-core-0.1.0-SNAPSHOT.jar

        Queda un solo artefacto sirviendo el frontend y la API en el mismo puerto y el mismo
        origen: desaparecen el proxy de Vite y el CORS. Es lo que va a correr en la máquina
        que haga de servidor del ambiente compartido — ver ARQUITECTURA_ECOPEDIA.md §6.4.

        Va como perfil y no en el ciclo normal a propósito: si el build del frontend entrara
        en 'mvn verify', el job "Backend (Maven)" de CI pasaría a necesitar Node y a tardar
        varios minutos más. Ese nombre es un context obligatorio del ruleset de main, así que
        cuanto menos se toque, mejor.
    -->
    <profiles>
        <profile>
            <id>web</id>

            <build>
                <plugins>
                    <!--
                        Descarga su propio Node y su propio pnpm en frontend/.mvn-node, en vez de
                        usar los del PATH. Así el build da lo mismo en las cuatro máquinas y en
                        cualquier servidor, tenga o no pnpm instalado. Se baja una sola vez.
                    -->
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>1.15.1</version>

                        <configuration>
                            <workingDirectory>${frontend.dir}</workingDirectory>
                            <installDirectory>${frontend.dir}/.mvn-node</installDirectory>
                        </configuration>

                        <executions>
                            <execution>
                                <id>install-node-and-pnpm</id>
                                <goals>
                                    <goal>install-node-and-pnpm</goal>
                                </goals>
                                <configuration>
                                    <!-- La misma línea que declara .nvmrc y que usa CI. -->
                                    <nodeVersion>v24.20.0</nodeVersion>
                                    <!-- La misma que declara "packageManager" en frontend/package.json. -->
                                    <pnpmVersion>11.24.0</pnpmVersion>
                                </configuration>
                            </execution>

                            <execution>
                                <id>pnpm-install</id>
                                <goals>
                                    <goal>pnpm</goal>
                                </goals>
                                <configuration>
                                    <arguments>install --frozen-lockfile</arguments>
                                </configuration>
                            </execution>

                            <execution>
                                <id>pnpm-build</id>
                                <goals>
                                    <goal>pnpm</goal>
                                </goals>
                                <configuration>
                                    <!-- 'pnpm build' = tsc -b && vite build. Si los tipos no cierran, falla acá. -->
                                    <arguments>run build</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!--
                        Spring Boot sirve como estático todo lo que encuentre en classpath:/static/.
                        Acá es donde el dist/ de Vite entra al JAR.
                    -->
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-frontend-dist</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${frontend.dir}/dist</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
