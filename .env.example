# Plantilla del .env. El de verdad se arma de una de estas dos formas:
#
#   pnpm env:init                 (o `node scripts/env-init.mjs`; sin Node, ver el README)
#
# que copia este archivo y completa cada variable vacía con un valor al azar; o a mano:
#
#   cp .env.example .env
#
# y completar TODAS las variables vacías. Con alguna vacía, `docker compose up` no arranca y dice
# cuál falta. El .env NO se versiona: lo lee docker compose solo, y los scripts del backend lo
# cargan con scripts/with-env.mjs.
#
# Hace falta para `pnpm demo`, para el JAR y para `docker compose up`. `pnpm dev` y
# `pnpm dev:mem` arrancan sin él, con valores de desarrollo.

# La firma de los tokens. La comparten los cuatro backends: core firma y los otros tres
# validan. Cambiarla desloguea a todo el mundo.
ECOPEDIA_JWT_SECRET=

# La contraseña de PostgreSQL. docker compose la usa al crear la base y el backend, al entrar.
ECOPEDIA_DB_PASSWORD=

# La contraseña del broker (Artemis). Lo mismo: la usa el contenedor al crearse y los módulos
# que publican o escuchan, al conectarse.
ECOPEDIA_BROKER_PASSWORD=

# La clave con la que Pagos se presenta ante la pasarela de pagos simulada. La leen los dos: la
# pasarela para exigirla y Pagos para mandarla.
ECOPEDIA_PAYMENT_GATEWAY_ACCESS_TOKEN=

# La contraseña del UsernameToken de WS-Security con que RedEléctrica se presenta ante la
# distribuidora simulada. La leen los dos: la distribuidora para exigirla y RedEléctrica (en
# ecopedia-integration) para mandarla. El usuario es `ecopedia`.
ECOPEDIA_POWER_GRID_PASSWORD=

# La clave con la que Terminales (en ecopedia-core) se presenta ante los cargadores simulados. La leen
# los dos: el simulador para exigirla y core para mandarla.
ECOPEDIA_CHARGER_ACCESS_TOKEN=

# La clave de servicio con que un artefacto de Ecopedia llama a las rutas /internal/** de otro (hoy,
# SesionesDeCarga en ecopedia-charging a RedEléctrica en ecopedia-integration). No es la de un
# usuario. La leen los dos.
ECOPEDIA_INTERNAL_TOKEN=

# El bloqueo del login: cuántos intentos fallidos seguidos lo disparan y cuántos minutos dura.
# Si no están, core usa 5 y 15. Para la demo conviene ECOPEDIA_LOGIN_LOCK_MINUTES=1.
ECOPEDIA_LOGIN_MAX_FAILURES=5
ECOPEDIA_LOGIN_LOCK_MINUTES=15

# Las dos cuentas con las que se entra la primera vez: un ADMIN y un CPO. Core las crea al arrancar si
# no existen, y no las vuelve a tocar: las contraseñas se cambian después desde el perfil. Desde el
# ADMIN se promueve al resto de los usuarios en /admin. La contraseña, de 6 caracteres o más; si la
# dejás vacía, `pnpm env:init` pone una al azar (queda acá, en el .env).
#
# La primera vez que se crea la cuenta CPO, las 15 estaciones de ejemplo se reparten entre los CPO
# que haya; en un sistema recién levantado quedan todas para esta cuenta.
ECOPEDIA_ADMIN_EMAIL=matiasruizadmin@gmail.com
ECOPEDIA_ADMIN_PASSWORD=
ECOPEDIA_CPO_EMAIL=matiasruizcpo@gmail.com
ECOPEDIA_CPO_PASSWORD=

# Por dónde atiende el sistema cuando corre todo con `docker compose up` (ver docker/Caddyfile).
# `:80` es http://localhost, para una PC. En el servidor va el dominio (por ejemplo
# `pedia.com.ar`), y Caddy saca solo el certificado HTTPS. `pnpm dev` y `pnpm demo` no la usan.
# Si en tu PC el puerto 80 está ocupado, agregá ECOPEDIA_HTTP_PORT=8080 y entrá por ese.
ECOPEDIA_SITE_ADDRESS=:80
