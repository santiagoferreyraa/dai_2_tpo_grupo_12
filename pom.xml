<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ecopedia</groupId>
    <artifactId>ecopedia-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Ecopedia — Parent</name>
    <description>
        Plataforma de gestión, reserva y tarificación de estaciones de carga para vehículos eléctricos.
        TP Integrador — Desarrollo de Aplicaciones II.
    </description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spotless.version>2.44.5</spotless.version>

        <!-- Calidad de las pruebas (QA-17, QA-22, QA-23). Ver qa/README.md. -->
        <jacoco.version>0.8.12</jacoco.version>
        <pitest.version>1.19.4</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <sonar-maven-plugin.version>5.1.0.4751</sonar-maven-plugin.version>

        <!--
            Umbrales de cobertura de la capa de dominio y de servicio, los del eje B: 80 % de
            líneas y 70 % de ramas, por módulo. Si un cambio los baja, `mvn verify` falla.

            Primera medición (29/10): 94,8 % de líneas y 86,3 % de ramas en total; el más justo
            es integration, con 72,7 % de ramas.
        -->
        <coverage.lines.minimum>0.80</coverage.lines.minimum>
        <coverage.branches.minimum>0.70</coverage.branches.minimum>

        <!-- Lo mismo para la mutación (eje B: 60 %). Se sube cuando se conozca el número real. -->
        <mutation.threshold>0</mutation.threshold>

        <!-- La versión del launcher que trae Spring Boot 3.5.6 (JUnit 5.12.2 = Platform 1.12.2). -->
        <junit-platform.version>1.12.2</junit-platform.version>

        <!-- Sonar lee el XML de JaCoCo de cada módulo. -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <!--
        Un módulo por artefacto desplegable. Ver ARQUITECTURA_ECOPEDIA.md §6.4.
        Los componentes de negocio viven dentro de estos módulos, cada uno con su interfaz explícita.

        Los cuatro están declarados desde el principio, aunque tres estén todavía vacíos.
        Es a propósito: si cada uno creara su módulo cuando lo necesita, los cuatro editaríamos
        esta misma lista la misma semana y cada merge conflictuaría acá. Declarados de entrada,
        este archivo no se vuelve a tocar.

        Los sistemas externos simulados viven aparte, en simulation/: no son Ecopedia, son los
        procesos con los que Ecopedia se integra. Cada uno corre por su cuenta y habla un
        protocolo real: la pasarela (REST), la distribuidora (SOAP) y los cargadores (órdenes por
        REST, telemetría por el tópico).
    -->
    <modules>
        <module>backend/ecopedia-core</module>
        <module>backend/ecopedia-charging</module>
        <module>backend/ecopedia-integration</module>
        <module>backend/ecopedia-async</module>
        <module>simulation/payment-gateway</module>
        <module>simulation/power-grid</module>
        <module>simulation/charger</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Formateador único para las cuatro máquinas.

                    Sin esto, cada IDE reordena imports y reindenta a su gusto: alguien guarda un
                    archivo y aparecen 40 líneas cambiadas que no tocó, y el próximo merge sobre ese
                    archivo conflictúa entero.

                    - "mvn spotless:apply" formatea.
                    - "mvn verify" falla si algo quedó sin formatear (ver la ejecución de abajo).
                -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>

                    <configuration>
                        <java>
                            <removeUnusedImports/>
                            <!--
                                Palantir en vez de google-java-format: indenta con 4 espacios,
                                que es el estilo que ya tiene el código y el que usa IntelliJ
                                por defecto. Cambiar a 2 sería reescribir todo sin motivo.
                            -->
                            <palantirJavaFormat/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>

                        <!-- Recursos de texto: solo higiene, no reformateo. -->
                        <formats>
                            <format>
                                <includes>
                                    <include>src/**/*.yml</include>
                                    <include>src/**/*.yaml</include>
                                    <include>src/**/*.properties</include>
                                    <include>src/**/*.sql</include>
                                </includes>
                                <trimTrailingWhitespace/>
                                <endWithNewline/>
                                <indent>
                                    <spaces>true</spaces>
                                    <spacesPerTab>2</spacesPerTab>
                                </indent>
                            </format>
                        </formats>
                    </configuration>

                    <executions>
                        <execution>
                            <id>spotless-check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!--
                    Cobertura (QA-22). `mvn verify` deja en target/site/jacoco/ de cada módulo un
                    reporte HTML (index.html) y el jacoco.xml que lee Sonar.

                    El umbral se mide SOLO sobre la capa de dominio y de servicio, que es lo que
                    pide el eje B: los controladores, la configuración y los DTO quedan afuera
                    del cálculo, aunque igual aparecen en el reporte.
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>jacoco-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <!-- Qué clases entran en el cálculo: dominio y servicio de los
                                     cuatro artefactos. Los simuladores no son Ecopedia. -->
                                <includes>
                                    <include>com/ecopedia/*/*/domain/**</include>
                                    <include>com/ecopedia/*/*/service/**</include>
                                </includes>
                                <excludes>
                                    <exclude>com/ecopedia/simulation/**</exclude>
                                </excludes>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${coverage.lines.minimum}</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${coverage.branches.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Mutation testing (QA-23): `mvn -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage`

            PIT mete errores chicos en el código (invierte un if, cambia un < por un <=, borra una
            línea) y vuelve a correr los tests: si alguno falla, el mutante "murió" y los tests
            sirven; si todos siguen en verde, sobrevivió. Es lo mismo que hace el docente en vivo,
            pero automático y sobre cientos de cambios.

            Solo la capa de dominio y de servicio, y solo con los tests unitarios: los
            @SpringBootTest levantan el contexto entero por cada mutante y la corrida pasaría de
            minutos a horas. Corre en el QA nocturno, no en cada PR.

            El reporte queda en target/pit-reports/ de cada módulo.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                            <!-- El plugin de JUnit 5 lo declara "provided": hay que darle el launcher. -->
                            <dependency>
                                <groupId>org.junit.platform</groupId>
                                <artifactId>junit-platform-launcher</artifactId>
                                <version>${junit-platform.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>com.ecopedia.*.*.domain.*</param>
                                <param>com.ecopedia.*.*.service.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.ecopedia.*.*.domain.*Test</param>
                                <param>com.ecopedia.*.*.service.*Test</param>
                                <param>com.ecopedia.*.*.*ServiceTest</param>
                            </targetTests>
                            <excludedClasses>
                                <param>com.ecopedia.simulation.*</param>
                            </excludedClasses>
                            <excludedTestClasses>
                                <!-- 32 hilos compitiendo: bajo PIT se vuelve lento e inestable. -->
                                <param>com.ecopedia.*.*.*.BookingConcurrencyTest</param>
                                <param>com.ecopedia.simulation.*</param>
                            </excludedTestClasses>
                            <mutationThreshold>${mutation.threshold}</mutationThreshold>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <threads>2</threads>
                            <!-- Un módulo sin clases de dominio no tiene que romper la corrida. -->
                            <failWhenNoMutations>false</failWhenNoMutations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
