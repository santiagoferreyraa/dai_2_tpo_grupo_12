<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ecopedia</groupId>
    <artifactId>ecopedia-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Ecopedia — Parent</name>
    <description>
        Plataforma de gestión, reserva y tarificación de estaciones de carga para vehículos eléctricos.
        TP Integrador — Desarrollo de Aplicaciones II.
    </description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spotless.version>2.44.5</spotless.version>
    </properties>

    <!--
        Un módulo por artefacto desplegable. Ver ARQUITECTURA_ECOPEDIA.md §6.4.
        Los componentes de negocio viven dentro de estos módulos, cada uno con su interfaz explícita.

        Los cuatro están declarados desde el principio, aunque tres estén todavía vacíos.
        Es a propósito: si cada uno creara su módulo cuando lo necesita, los cuatro editaríamos
        esta misma lista la misma semana y cada merge conflictuaría acá. Declarados de entrada,
        este archivo no se vuelve a tocar.

        Los sistemas externos simulados viven aparte, en simulation/: no son Ecopedia, son los
        procesos con los que Ecopedia se integra. Cada uno corre por su cuenta y habla un
        protocolo real: la pasarela (REST), la distribuidora (SOAP) y los cargadores (órdenes por
        REST, telemetría por el tópico).
    -->
    <modules>
        <module>backend/ecopedia-core</module>
        <module>backend/ecopedia-charging</module>
        <module>backend/ecopedia-integration</module>
        <module>backend/ecopedia-async</module>
        <module>simulation/payment-gateway</module>
        <module>simulation/power-grid</module>
        <module>simulation/charger</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Formateador único para las cuatro máquinas.

                    Sin esto, cada IDE reordena imports y reindenta a su gusto: alguien guarda un
                    archivo y aparecen 40 líneas cambiadas que no tocó, y el próximo merge sobre ese
                    archivo conflictúa entero.

                    - "mvn spotless:apply" formatea.
                    - "mvn verify" falla si algo quedó sin formatear (ver la ejecución de abajo).
                -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>

                    <configuration>
                        <java>
                            <removeUnusedImports/>
                            <!--
                                Palantir en vez de google-java-format: indenta con 4 espacios,
                                que es el estilo que ya tiene el código y el que usa IntelliJ
                                por defecto. Cambiar a 2 sería reescribir todo sin motivo.
                            -->
                            <palantirJavaFormat/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>

                        <!-- Recursos de texto: solo higiene, no reformateo. -->
                        <formats>
                            <format>
                                <includes>
                                    <include>src/**/*.yml</include>
                                    <include>src/**/*.yaml</include>
                                    <include>src/**/*.properties</include>
                                    <include>src/**/*.sql</include>
                                </includes>
                                <trimTrailingWhitespace/>
                                <endWithNewline/>
                                <indent>
                                    <spaces>true</spaces>
                                    <spacesPerTab>2</spacesPerTab>
                                </indent>
                            </format>
                        </formats>
                    </configuration>

                    <executions>
                        <execution>
                            <id>spotless-check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
