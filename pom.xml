<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ecopedia</groupId>
    <artifactId>ecopedia-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Ecopedia — Parent</name>
    <description>
        Plataforma de gestión, reserva y tarificación de estaciones de carga para vehículos eléctricos.
        TP Integrador — Desarrollo de Aplicaciones II.
    </description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spotless.version>2.44.5</spotless.version>
        <jacoco.version>0.8.12</jacoco.version>
        <spotbugs-plugin.version>4.10.4.1</spotbugs-plugin.version>
        <pmd-plugin.version>3.28.0</pmd-plugin.version>

        <!--
            Versiones por encima de las que trae Spring Boot 3.5.16, solo para cerrar vulnerabilidades
            altas o críticas que Trivy encuentra en los JAR (eje D: 0 sin mitigar). Son parches de la
            misma línea que Boot ya usa, salvo httpcore5 (5.3 → 5.4), que no tiene el arreglo en 5.3.
            Lo que no se puede cerrar sin pasar a Boot 4 está justificado en .trivyignore.
            Al subir Spring Boot, revisar si alguna sobra: si Boot ya trae una igual o mayor, se borra.
        -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <netty.version>4.1.137.Final</netty.version>
        <tomcat.version>10.1.59</tomcat.version>
        <postgresql.version>42.7.12</postgresql.version>
        <httpcore5.version>5.4.3</httpcore5.version>
    </properties>

    <!--
        Bibliotecas que Spring Boot no administra y llegan como transitivas con vulnerabilidades
        altas o críticas: Bouncy Castle (por WS-Security en integration), Guava y commons-beanutils
        (por Artemis). Mismo criterio que las propiedades de arriba.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.85</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.2-jre</version>
            </dependency>
            <dependency>
                <groupId>commons-beanutils</groupId>
                <artifactId>commons-beanutils</artifactId>
                <version>1.11.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Un módulo por artefacto desplegable. Ver ARQUITECTURA_ECOPEDIA.md §6.4.
        Los componentes de negocio viven dentro de estos módulos, cada uno con su interfaz explícita.

        Los cuatro están declarados desde el principio, aunque tres estén todavía vacíos.
        Es a propósito: si cada uno creara su módulo cuando lo necesita, los cuatro editaríamos
        esta misma lista la misma semana y cada merge conflictuaría acá. Declarados de entrada,
        este archivo no se vuelve a tocar.

        Los sistemas externos simulados viven aparte, en simulation/: no son Ecopedia, son los
        procesos con los que Ecopedia se integra. Cada uno corre por su cuenta y habla un
        protocolo real: la pasarela (REST), la distribuidora (SOAP) y los cargadores (órdenes por
        REST, telemetría por el tópico).
    -->
    <modules>
        <module>backend/ecopedia-core</module>
        <module>backend/ecopedia-charging</module>
        <module>backend/ecopedia-integration</module>
        <module>backend/ecopedia-async</module>
        <module>simulation/payment-gateway</module>
        <module>simulation/power-grid</module>
        <module>simulation/charger</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Formateador único para las cuatro máquinas.

                    Sin esto, cada IDE reordena imports y reindenta a su gusto: alguien guarda un
                    archivo y aparecen 40 líneas cambiadas que no tocó, y el próximo merge sobre ese
                    archivo conflictúa entero.

                    - "mvn spotless:apply" formatea.
                    - "mvn verify" falla si algo quedó sin formatear (ver la ejecución de abajo).
                -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>

                    <configuration>
                        <java>
                            <removeUnusedImports/>
                            <!--
                                Palantir en vez de google-java-format: indenta con 4 espacios,
                                que es el estilo que ya tiene el código y el que usa IntelliJ
                                por defecto. Cambiar a 2 sería reescribir todo sin motivo.
                            -->
                            <palantirJavaFormat/>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>

                        <!-- Recursos de texto: solo higiene, no reformateo. -->
                        <formats>
                            <format>
                                <includes>
                                    <include>src/**/*.yml</include>
                                    <include>src/**/*.yaml</include>
                                    <include>src/**/*.properties</include>
                                    <include>src/**/*.sql</include>
                                </includes>
                                <trimTrailingWhitespace/>
                                <endWithNewline/>
                                <indent>
                                    <spaces>true</spaces>
                                    <spacesPerTab>2</spacesPerTab>
                                </indent>
                            </format>
                        </formats>
                    </configuration>

                    <executions>
                        <execution>
                            <id>spotless-check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>**/contract/**</exclude>
                            <exclude>**/ws/contract/**</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <excludes>
                                    <exclude>**/contract/**</exclude>
                                    <exclude>**/ws/contract/**</exclude>
                                </excludes>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.80</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.70</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!--
                    Análisis estático (G3 de la prueba de testing): SpotBugs mira el bytecode y PMD
                    el código fuente. Los dos corren en "mvn verify", o sea dentro del check
                    "Backend (Maven)" de CI, sin secretos ni servicios externos: un hallazgo nuevo
                    hace fallar el build igual que un test.

                    - "mvn verify" los corre; "mvn spotbugs:gui" muestra los hallazgos de SpotBugs.
                    - Lo que no se cuenta, y por qué, está en config/spotbugs-exclude.xml y
                      config/pmd-ruleset.xml.
                -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-plugin.version}</version>
                    <configuration>
                        <effort>Max</effort>
                        <!-- Falla con prioridad media o alta; las de prioridad baja son opiniones de estilo. -->
                        <threshold>Medium</threshold>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs-exclude.xml</excludeFilterFile>
                    </configuration>
                    <executions>
                        <execution>
                            <id>spotbugs-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${pmd-plugin.version}</version>
                    <configuration>
                        <rulesets>
                            <ruleset>${maven.multiModuleProjectDirectory}/config/pmd-ruleset.xml</ruleset>
                        </rulesets>
                        <targetJdk>${java.version}</targetJdk>
                        <!-- Falla con prioridad 1 o 2; el resto queda en target/pmd.xml. -->
                        <failurePriority>2</failurePriority>
                        <printFailingErrors>true</printFailingErrors>
                        <linkXRef>false</linkXRef>
                        <!-- Las clases que genera JAXB desde el XSD de la distribuidora. -->
                        <excludeRoots>
                            <excludeRoot>${project.build.directory}/generated-sources</excludeRoot>
                        </excludeRoots>
                    </configuration>
                    <executions>
                        <execution>
                            <id>pmd-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
