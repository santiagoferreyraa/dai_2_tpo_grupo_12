<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ecopedia</groupId>
        <artifactId>ecopedia-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>charger-simulator</artifactId>
    <name>Simulación — Cargadores</name>
    <description>
        El hardware de carga simulado, como proceso aparte (RNF04). Recibe las órdenes de activar y
        desactivar un conector por REST y, mientras carga, publica la telemetría en el tópico
        telemetry.charging de Artemis. No es parte de Ecopedia: Terminales le habla por HTTP, igual
        que le hablaría a la central de un fabricante. Ver ARQUITECTURA §2.3, ficha 2.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- La telemetría sale por el broker, igual que la publicaría un cargador de verdad. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-artemis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Broker embebido para los tests, como en ecopedia-charging: con esto en el classpath,
            Spring Boot levanta uno dentro de la JVM y CI prueba la publicación de verdad, sin Docker.
        -->
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>artemis-jakarta-server</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
