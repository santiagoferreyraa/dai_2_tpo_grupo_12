{
  "name": "ecopedia",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "mprocs",
    "dev:back": "node scripts/free-port.mjs 8081 && mvn -pl backend/ecopedia-core spring-boot:run -Dspring-boot.run.profiles=local",
    "dev:charging": "node scripts/free-port.mjs 8082 && mvn -pl backend/ecopedia-charging spring-boot:run -Dspring-boot.run.profiles=local",
    "dev:pay": "node scripts/free-port.mjs 8083 && mvn -pl backend/ecopedia-integration spring-boot:run -Dspring-boot.run.profiles=local",
    "dev:async": "node scripts/free-port.mjs 8084 && mvn -pl backend/ecopedia-async spring-boot:run -Dspring-boot.run.profiles=local",
    "dev:front": "node scripts/free-port.mjs 5173 && pnpm --dir frontend dev",
    "dev:plain": "concurrently --names back,charging,pay,front --prefix-colors cyan,yellow,blue,magenta --kill-others-on-fail \"pnpm dev:back\" \"pnpm dev:charging\" \"pnpm dev:pay\" \"pnpm dev:front\"",
    "dev:mem": "mprocs --config mprocs-mem.yaml",
    "dev:mem:back": "node scripts/free-port.mjs 8081 && mvn -pl backend/ecopedia-core spring-boot:run -Dspring-boot.run.profiles=dev",
    "dev:mem:charging": "node scripts/free-port.mjs 8082 && mvn -pl backend/ecopedia-charging spring-boot:run -Dspring-boot.run.profiles=dev",
    "dev:mem:pay": "node scripts/free-port.mjs 8083 && mvn -pl backend/ecopedia-integration spring-boot:run -Dspring-boot.run.profiles=dev",
    "dev:mem:async": "node scripts/free-port.mjs 8084 && mvn -pl backend/ecopedia-async spring-boot:run -Dspring-boot.run.profiles=dev",
    "demo": "mprocs --config mprocs-demo.yaml",
    "demo:back": "node scripts/free-port.mjs 8081 && mvn -pl backend/ecopedia-core spring-boot:run",
    "demo:charging": "node scripts/free-port.mjs 8082 && mvn -pl backend/ecopedia-charging spring-boot:run",
    "demo:pay": "node scripts/free-port.mjs 8083 && mvn -pl backend/ecopedia-integration spring-boot:run",
    "demo:async": "node scripts/free-port.mjs 8084 && mvn -pl backend/ecopedia-async spring-boot:run",
    "free-ports": "node scripts/free-port.mjs 8081 8082 8083 8084 5173",
    "build": "mvn -Pweb clean package",
    "start": "java -jar backend/ecopedia-core/target/ecopedia-core-0.1.0-SNAPSHOT.jar"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "mprocs": "^0.9.6"
  }
}
